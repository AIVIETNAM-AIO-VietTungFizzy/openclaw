{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclip.ai/schemas/paperclip-openclaw-contract.v1.json",
  "title": "Paperclip–OpenClaw Contract Envelope",
  "description": "Frozen request/response envelope for the Paperclip Layer 4B ↔ OpenClaw Gateway contract (V24 §2 Khóa cứng).",
  "version": "2026-05-28",
  "definitions": {
    "Caller": {
      "type": "object",
      "description": "Identity of the calling agent and its runtime context.",
      "required": ["agentId", "sessionKey", "tenantId", "companyId", "employeeId", "package", "runtimeLane"],
      "properties": {
        "agentId": { "type": "string", "description": "Unique agent identifier." },
        "sessionKey": { "type": "string", "description": "OpenClaw session key for this call." },
        "tenantId": { "type": "string", "description": "V24 multi-tenant isolation: tenant identifier." },
        "companyId": { "type": "string", "description": "Company/organization identifier." },
        "employeeId": { "type": "string", "description": "Authenticated employee identifier." },
        "package": {
          "type": "string",
          "enum": ["L0", "L1", "L2", "L3"],
          "description": "Agent capability package level."
        },
        "runtimeLane": {
          "type": "string",
          "enum": ["7A", "7B", "deer-flow"],
          "description": "Runtime execution lane."
        }
      },
      "additionalProperties": false
    },
    "SuccessMeta": {
      "type": "object",
      "required": ["attempt", "retryable", "approved", "approvalId"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "description": "Attempt number (1-based)." },
        "retryable": { "type": "boolean", "description": "Whether the upstream indicated this response may be retried." },
        "approved": { "type": "boolean", "description": "Whether an approval was granted for this operation." },
        "approvalId": { "type": ["string", "null"], "description": "Approval record ID if approved." }
      },
      "additionalProperties": false
    },
    "ErrorMeta": {
      "type": "object",
      "required": ["attempt", "approved"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1, "description": "Attempt number (1-based)." },
        "approved": { "type": "boolean", "description": "Whether an approval was granted for this operation." }
      },
      "additionalProperties": false
    },
    "ErrorDetail": {
      "type": "object",
      "required": ["code", "category", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Machine-readable error code matching paperclip-openclaw-error-taxonomy.v1.json"
        },
        "category": {
          "type": "string",
          "enum": ["SCHEMA", "POLICY", "IDEMPOTENCY", "UPSTREAM", "EXECUTION", "INTERNAL"],
          "description": "Error category for routing/handling decisions."
        },
        "message": { "type": "string", "description": "Human-readable error message." },
        "retryable": { "type": "boolean", "description": "Whether this error may be retried safely." },
        "details": {
          "type": "object",
          "description": "Additional structured error details (e.g., required_package, approval_class).",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "request": {
    "type": "object",
    "description": "Merged request envelope from OpenClaw Gateway → Paperclip 4B.",
    "required": ["contractVersion", "requestId", "operation", "traceId", "caller", "params"],
    "properties": {
      "contractVersion": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Contract version date. Only '2026-05-28' is accepted in v1."
      },
      "requestId": { "type": "string", "description": "Correlation ID across logs, approvals, and retries." },
      "operation": { "type": "string", "description": "Qualified operation name from the operation registry (e.g., 'paperclip.complete_work_item')." },
      "idempotencyKey": {
        "type": ["string", "null"],
        "description": "Required for mutations. Must be present for operations where requiresIdempotencyKey=true in the registry."
      },
      "traceId": { "type": "string", "description": "V24 §11 audit root trace ID." },
      "caller": { "$ref": "#/definitions/Caller" },
      "params": {
        "type": "object",
        "description": "Operation-specific parameters, validated against the registry schema for the operation.",
        "additionalProperties": true
      }
    },
    "additionalProperties": false
  },
  "successResponse": {
    "type": "object",
    "description": "Frozen success response from Paperclip 4B → OpenClaw Gateway.",
    "required": ["ok", "contractVersion", "requestId", "idempotencyKey", "operation", "result", "meta"],
    "properties": {
      "ok": { "type": "boolean", "const": true },
      "contractVersion": { "type": "string" },
      "requestId": { "type": "string" },
      "idempotencyKey": { "type": ["string", "null"] },
      "operation": { "type": "string" },
      "result": {
        "type": "object",
        "description": "Operation-specific result payload.",
        "additionalProperties": true
      },
      "meta": { "$ref": "#/definitions/SuccessMeta" }
    },
    "additionalProperties": false
  },
  "errorResponse": {
    "type": "object",
    "description": "Frozen error response from Paperclip 4B → OpenClaw Gateway.",
    "required": ["ok", "contractVersion", "requestId", "operation", "error", "meta"],
    "properties": {
      "ok": { "type": "boolean", "const": false },
      "contractVersion": { "type": "string" },
      "requestId": { "type": "string" },
      "operation": { "type": "string" },
      "error": { "$ref": "#/definitions/ErrorDetail" },
      "meta": { "$ref": "#/definitions/ErrorMeta" }
    },
    "additionalProperties": false
  }
}